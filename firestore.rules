rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidFacetList(values, allowed, maxSize) {
      return values is list && values.size() <= maxSize && values.hasOnly(allowed);
    }
    // Rules has no per-element string predicate, so pending is checked index-wise.
    function pendingAtOk(values, i) {
      return values.size() <= i
        || (values[i] is string && values[i].size() >= 1 && values[i].size() <= 24);
    }
    function isValidPending(values) {
      return values is list && values.size() <= 8
        && pendingAtOk(values, 0) && pendingAtOk(values, 1)
        && pendingAtOk(values, 2) && pendingAtOk(values, 3)
        && pendingAtOk(values, 4) && pendingAtOk(values, 5)
        && pendingAtOk(values, 6) && pendingAtOk(values, 7);
    }
    function facetTotal(tags) {
      return (("menus" in tags) ? tags.menus.size() : 0)
        + (("servings" in tags) ? tags.servings.size() : 0)
        + (("ingredients" in tags) ? tags.ingredients.size() : 0)
        + (("origins" in tags) ? tags.origins.size() : 0)
        + (("priceTier" in tags) ? 1 : 0)
        + (("healthStyle" in tags) ? 1 : 0);
    }
    function isValidTags(tags) {
      return tags is map
        && tags.keys().hasOnly(["menus", "servings", "ingredients", "origins", "priceTier", "healthStyle", "pending"])
        && (!("menus" in tags) || isValidFacetList(tags.menus, ["burger", "pizza", "pasta", "sandwich", "sushi", "rice-bowl", "noodle-bowl", "soup", "porridge", "salad", "fried-chicken", "grill", "dessert", "bakery", "coffee", "beverage"], 3))
        && (!("servings" in tags) || isValidFacetList(tags.servings, ["meal", "snack"], 2))
        && (!("ingredients" in tags) || isValidFacetList(tags.ingredients, ["rice", "noodles", "bread", "potato", "porridge", "none", "chicken", "beef", "seafood", "egg", "plant", "pork", "mixed"], 5))
        && (!("origins" in tags) || isValidFacetList(tags.origins, ["indonesian", "chinese", "japanese", "korean", "western", "middle-eastern", "southeast-asian", "mixed"], 3))
        && (!("priceTier" in tags) || tags.priceTier in ["budget", "regular", "premium", "splurge"])
        && (!("healthStyle" in tags) || tags.healthStyle in ["comfort", "everyday", "fresh"])
        && (!("pending" in tags) || isValidPending(tags.pending))
        && facetTotal(tags) <= 8;
    }
    function isValidFoodDoc(data) {
      return data.keys().hasOnly(
          ["areas", "name", "tags", "createdByUid", "createdAt", "updatedAt", "instagramUrl", "tiktokUrl"])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.areas is list
        && data.areas.size() >= 1
        && data.areas.size() <= 3
        && data.areas.hasOnly(["batam", "malang", "surabaya"])
        && ("tags" in data)
        && isValidTags(data.tags)
        && (!("instagramUrl" in data)
          || (data.instagramUrl is string
            && data.instagramUrl.size() >= 1
            && data.instagramUrl.size() <= 300))
        && (!("tiktokUrl" in data)
          || (data.tiktokUrl is string
            && data.tiktokUrl.size() >= 1
            && data.tiktokUrl.size() <= 300));
    }
    match /food_places/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && isValidFoodDoc(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid;

      // Any logged-in user may edit any doc (shared catalog), but createdByUid
      // is immutable console forensics — never changed by an update.
      allow update: if request.auth != null
        && isValidFoodDoc(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid;

      allow delete: if request.auth != null;
    }
  }
}
