rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Facet values are open vocabulary: any 1-24 char string. Rules has no
    // per-element string predicate, so values are checked index-wise (the
    // largest facet cap is 5, which covers the smaller facets too).
    function facetValueAtOk(values, i) {
      return values.size() <= i
        || (values[i] is string && values[i].size() >= 1 && values[i].size() <= 24);
    }
    function isValidFacetValues(values, maxSize) {
      return values is list && values.size() <= maxSize
        && facetValueAtOk(values, 0) && facetValueAtOk(values, 1)
        && facetValueAtOk(values, 2) && facetValueAtOk(values, 3)
        && facetValueAtOk(values, 4);
    }
    // Rules has no per-element string predicate, so pending is checked index-wise.
    function pendingAtOk(values, i) {
      return values.size() <= i
        || (values[i] is string && values[i].size() >= 1 && values[i].size() <= 24);
    }
    function isValidPending(values) {
      return values is list && values.size() <= 8
        && pendingAtOk(values, 0) && pendingAtOk(values, 1)
        && pendingAtOk(values, 2) && pendingAtOk(values, 3)
        && pendingAtOk(values, 4) && pendingAtOk(values, 5)
        && pendingAtOk(values, 6) && pendingAtOk(values, 7);
    }
    function facetTotal(tags) {
      return (("menus" in tags) ? tags.menus.size() : 0)
        + (("servings" in tags) ? tags.servings.size() : 0)
        + (("ingredients" in tags) ? tags.ingredients.size() : 0)
        + (("origins" in tags) ? tags.origins.size() : 0)
        + (("priceTier" in tags) ? 1 : 0)
        + (("healthStyle" in tags) ? 1 : 0);
    }
    // Rules v2 cannot iterate dynamic map keys, so per-value contents inside
    // open cannot be validated index-wise like the six known facets. Rules
    // enforce open is a map with at most 8 keys; per-facet values (pattern,
    // cap 5) and the resolved total (known + open <= 8) are enforced by the
    // client Zod schema, normalizeFoodTags, and the migration script.
    function isValidOpen(tags) {
      return !("open" in tags) || (tags.open is map && tags.open.keys().size() <= 8);
    }
    function isValidTags(tags) {
      return tags is map
        && tags.keys().hasOnly(["menus", "servings", "ingredients", "origins", "priceTier", "healthStyle", "open", "pending"])
        && (!("menus" in tags) || isValidFacetValues(tags.menus, 3))
        && (!("servings" in tags) || isValidFacetValues(tags.servings, 2))
        && (!("ingredients" in tags) || isValidFacetValues(tags.ingredients, 5))
        && (!("origins" in tags) || isValidFacetValues(tags.origins, 3))
        && (!("priceTier" in tags) || (tags.priceTier is string && tags.priceTier.size() >= 1 && tags.priceTier.size() <= 24))
        && (!("healthStyle" in tags) || (tags.healthStyle is string && tags.healthStyle.size() >= 1 && tags.healthStyle.size() <= 24))
        && isValidOpen(tags)
        && (!("pending" in tags) || isValidPending(tags.pending))
        && facetTotal(tags) <= 8;
    }
    function isValidFoodDoc(data) {
      return data.keys().hasOnly(
          ["areas", "name", "tags", "createdByUid", "createdAt", "updatedAt", "instagramUrl", "tiktokUrl"])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.areas is list
        && data.areas.size() >= 1
        && data.areas.size() <= 3
        && data.areas.hasOnly(["batam", "malang", "surabaya"])
        && ("tags" in data)
        && isValidTags(data.tags)
        && (!("instagramUrl" in data)
          || (data.instagramUrl is string
            && data.instagramUrl.size() >= 1
            && data.instagramUrl.size() <= 300))
        && (!("tiktokUrl" in data)
          || (data.tiktokUrl is string
            && data.tiktokUrl.size() >= 1
            && data.tiktokUrl.size() <= 300));
    }
    match /food_places/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && isValidFoodDoc(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid;

      // Any logged-in user may edit any doc (shared catalog), but createdByUid
      // is immutable console forensics — never changed by an update.
      allow update: if request.auth != null
        && isValidFoodDoc(request.resource.data)
        && request.resource.data.createdByUid == resource.data.createdByUid;

      allow delete: if request.auth != null;
    }
    // Tag registry: UI vocab + synonyms. food_places keeps plain strings with
    // open-vocabulary facet values (structural caps only); this collection
    // never gates reads.
    function tagSynonymAtOk(values, i) {
      return values.size() <= i
        || (values[i] is string && values[i].size() >= 1 && values[i].size() <= 24);
    }
    function isValidSynonyms(values) {
      return values is list && values.size() <= 20
        && tagSynonymAtOk(values, 0) && tagSynonymAtOk(values, 1)
        && tagSynonymAtOk(values, 2) && tagSynonymAtOk(values, 3)
        && tagSynonymAtOk(values, 4) && tagSynonymAtOk(values, 5)
        && tagSynonymAtOk(values, 6) && tagSynonymAtOk(values, 7)
        && tagSynonymAtOk(values, 8) && tagSynonymAtOk(values, 9)
        && tagSynonymAtOk(values, 10) && tagSynonymAtOk(values, 11)
        && tagSynonymAtOk(values, 12) && tagSynonymAtOk(values, 13)
        && tagSynonymAtOk(values, 14) && tagSynonymAtOk(values, 15)
        && tagSynonymAtOk(values, 16) && tagSynonymAtOk(values, 17)
        && tagSynonymAtOk(values, 18) && tagSynonymAtOk(values, 19);
    }
    function isValidTagDoc(data) {
      return data.keys().hasOnly(
          ["facet", "value", "synonyms", "deprecated", "updatedByUid", "updatedAt", "createdAt"])
        && data.facet is string
        && data.facet.matches('^[a-z][A-Za-z0-9]{0,23}$')
        && data.value is string
        && data.value.matches('^[a-z0-9][a-z0-9-]{0,23}$')
        && (!("synonyms" in data) || isValidSynonyms(data.synonyms))
        && (!("deprecated" in data) || data.deprecated is bool)
        && (!("updatedByUid" in data) || data.updatedByUid is string);
    }
    match /tags/{tagId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && isValidTagDoc(request.resource.data);

      allow update: if request.auth != null
        && isValidTagDoc(request.resource.data);

      // Deprecate retires the entry; delete strips the value from places
      // first, then removes the registry doc.
      allow delete: if request.auth != null;
    }
  }
}
